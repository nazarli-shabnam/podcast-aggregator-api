# Application
APP_NAME="Podcast Aggregator API"
ENVIRONMENT=local
DEBUG=true

# Database (async SQLAlchemy / asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/podcasts

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379/0

# Ingestion targets (comma-separated)
CHART_COUNTRIES=us,gb
CHART_CATEGORIES=technology,business,news

# Enrichment credentials (optional; tasks skip gracefully when unset)
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# Podchaser chart scraping - OAuth2 client-credentials (optional; skips gracefully when unset)
PODCHASER_CLIENT_ID=
PODCHASER_CLIENT_SECRET=

# API auth + rate-limiting. Comma-separated valid keys; empty rejects every request.
API_KEYS=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
