# Application
APP_NAME="Podcast Aggregator API"
ENVIRONMENT=local
DEBUG=true

# Database (async SQLAlchemy / asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/podcasts

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379/0

# Ingestion targets (comma-separated). A category is lower-cased and its
# spaces/"&"/"and" collapsed to hyphens to build the Spotify chart URL slug
# (e.g. "True Crime" -> true-crime); "top-podcasts" is the overall chart.
# Podchaser receives the category name as-is.
CHART_COUNTRIES=us,gb
CHART_CATEGORIES=technology,business,news

# Optional overrides for Spotify category slugs that don't follow the default
# derivation. Format: "name=slug" pairs, comma-separated.
# SPOTIFY_CATEGORY_SLUGS=society & culture=society-culture,kids & family=kids-family

# Enrichment credentials (optional; tasks skip gracefully when unset)
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# Podchaser chart scraping - OAuth2 client-credentials (optional; skips gracefully when unset)
PODCHASER_CLIENT_ID=
PODCHASER_CLIENT_SECRET=

# API auth + rate-limiting. Comma-separated valid keys; empty rejects every request.
API_KEYS=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Outbound HTTP client tuning for scrapers / enrichment (defaults shown).
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
HTTP_RATE_LIMIT_PER_SECOND=5
